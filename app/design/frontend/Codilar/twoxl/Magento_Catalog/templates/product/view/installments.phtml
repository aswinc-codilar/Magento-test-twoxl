        'visa' => '<svg viewBox="0 0 38 24" aria-label="Visa" role="img"><text x="19" y="16.5" text-anchor="middle" '
            . 'font-family="Arial, sans-serif" font-size="11" font-weight="700" font-style="italic" fill="#1a1f71">VISA</text></svg>',
        'applepay' => '<svg viewBox="0 0 38 24" aria-label="Apple Pay" role="img"><path d="M11.3 8.4c.4-.5.7-1.2.6-1.9-.6 0-1.3.4-1.7.9-.4.4-.7 1.1-.6 1.8.6 0 1.3-.3 1.7-.8Zm.6 1c-.9 0-1.7.5-2.1.5-.5 0-1.1-.5-1.9-.5-1 0-1.9.6-2.4 1.5-1 1.8-.3 4.4.7 5.8.5.7 1 1.5 1.8 1.4.7 0 1-.5 1.8-.5.9 0 1.1.5 1.9.5s1.3-.7 1.7-1.4c.5-.8.8-1.6.8-1.6s-1.5-.6-1.5-2.3c0-1.4 1.1-2.1 1.2-2.2-.7-1-1.7-1.1-2-1.2Z" fill="#000"/>'
            . '<text x="25" y="16" text-anchor="middle" font-family="Arial, sans-serif" font-size="9.5" font-weight="600" fill="#000">Pay</text></svg>',
        'googlepay' => '<svg viewBox="0 0 38 24" aria-label="Google Pay" role="img"><text x="8" y="16" font-family="Arial, sans-serif" font-size="9.5" font-weight="700">'
            . '<tspan fill="#4285f4">G</tspan></text><text x="16.5" y="16" font-family="Arial, sans-serif" font-size="9.5" fill="#5f6368">Pay</text></svg>',
    ];
    $html = '<div class="installment-payment-logos">';
    foreach ($methods as $method) {
        $html .= '<span class="installment-payment-logo">' . $logos[$method] . '</span>';
    }
    return $html . '</div>';
};
