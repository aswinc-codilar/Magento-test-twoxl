<?php
/**
 * Tabby / Tamara "pay in installments" promo boxes, each opening a plans popup
 *
 * Plans come from the "tabby_plans" / "tamara_plans" layout arguments: number of payments and the
 * total fee in percent of the price. Amounts = price x (1 + fee%) / payments, recalculated by
 * js/installments.js whenever the product price changes.
 *
 * @var \Magento\Catalog\Block\Product\View $block
 * @var \Magento\Framework\Escaper $escaper
 */

$product = $block->getProduct();
if (!$product->isSaleable()) {
    return;
}

/** @var \Magento\Framework\Pricing\Helper\Data $priceHelper */
$priceHelper = $this->helper(\Magento\Framework\Pricing\Helper\Data::class);
$finalPrice = (float) $product->getPriceInfo()->getPrice('final_price')->getAmount()->getValue();
$jsonConfig = json_decode($block->getJsonConfig(), true);

$normalizePlans = function ($plans) {
    $plans = array_values(array_map(function ($plan) {
        return ['count' => (int) $plan['count'], 'fee' => (float) ($plan['fee'] ?? 0)];
    }, (array) $plans));
    usort($plans, function ($a, $b) {
        return $a['count'] <=> $b['count'];
    });
    return $plans;
};
$tabbyPlans = $normalizePlans($block->getData('tabby_plans'));
$tamaraPlans = $normalizePlans($block->getData('tamara_plans'));
if (!$tabbyPlans || !$tamaraPlans) {
    return;
}

$monthly = function (array $plan) use ($finalPrice) {
    return $finalPrice * (1 + $plan['fee'] / 100) / $plan['count'];
};
$monthlyFee = function (array $plan) use ($finalPrice) {
    return $finalPrice * $plan['fee'] / 100 / $plan['count'];
};
$money = function ($amount) use ($priceHelper) {
    return $priceHelper->currency($amount, true, false);
};

// The box text quotes the lowest monthly amount (the longest plan)
$tabbyLongest = end($tabbyPlans);
$tabbyFreeCount = $tabbyPlans[0]['count'];
$tamaraLongest = end($tamaraPlans);

/**
 * Renders an amount that js/installments.js keeps in sync with the price box
 */
$amount = function (array $plan, string $type, string $suffix = '') use ($escaper, $money, $monthly, $monthlyFee) {
    $value = $type === 'fee' ? $monthlyFee($plan) : $monthly($plan);
    return sprintf(
        '<span data-installment-amount data-count="%d" data-fee="%s" data-type="%s" data-suffix="%s">%s</span>',
        $plan['count'],
        $escaper->escapeHtmlAttr((string) $plan['fee']),
        $escaper->escapeHtmlAttr($type),
        $escaper->escapeHtmlAttr($suffix),
        $escaper->escapeHtml($money($value) . $suffix)
    );
};

/**
 * Small payment method badges shown at the bottom of the popups
 */
$paymentLogos = function (array $methods) {
    $logos = [
        'mastercard' => '<svg viewBox="0 0 38 24" aria-label="Mastercard" role="img"><circle cx="15" cy="12" r="7" fill="#eb001b"/>'
