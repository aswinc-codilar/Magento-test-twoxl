<?xml version="1.0"?>
<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <!-- Per-visitor content: never full-page cached -->
            <block class="Magento\Framework\View\Element\Template" name="guest.wishlist.items" cacheable="false"
                   template="Codilar_GuestWishlist::list.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Codilar\GuestWishlist\ViewModel\GuestWishlistItems</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
