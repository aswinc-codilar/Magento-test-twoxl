<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Runs before Magento's login guard (sortOrder 10): guests' "Add to Wish List" goes to the guest wish list -->
    <type name="Magento\Wishlist\Controller\Index\Add">
        <plugin name="codilar_guest_wishlist_add" type="Codilar\GuestWishlist\Plugin\GuestAddToWishlist" sortOrder="5"/>
    </type>
    <!-- Header heart icon: item count + link for guests and customers -->
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="header-wishlist" xsi:type="string">Codilar\GuestWishlist\CustomerData\HeaderWishlist</item>
            </argument>
        </arguments>
    </type>
</config>
