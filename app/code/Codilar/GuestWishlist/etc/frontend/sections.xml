<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Customer:etc/sections.xsd">
    <!-- Refresh the header wish list count after anything that can change it -->
    <action name="guestwishlist/index/remove">
        <section name="header-wishlist"/>
    </action>
    <action name="wishlist/index/add">
        <section name="header-wishlist"/>
    </action>
    <action name="wishlist/index/remove">
        <section name="header-wishlist"/>
    </action>
    <action name="wishlist/index/update">
        <section name="header-wishlist"/>
    </action>
    <action name="wishlist/index/cart">
        <section name="header-wishlist"/>
    </action>
    <action name="wishlist/index/allcart">
        <section name="header-wishlist"/>
    </action>
    <action name="wishlist/index/fromcart">
        <section name="header-wishlist"/>
    </action>
    <action name="customer/account/loginPost">
        <section name="header-wishlist"/>
    </action>
    <action name="customer/account/createPost">
        <section name="header-wishlist"/>
    </action>
    <action name="customer/ajax/login">
        <section name="header-wishlist"/>
    </action>
    <action name="customer/account/logout">
        <section name="header-wishlist"/>
    </action>
</config>
