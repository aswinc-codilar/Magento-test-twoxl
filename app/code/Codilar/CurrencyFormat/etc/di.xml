<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Prices rendered in PHP -->
    <type name="Magento\Directory\Model\Currency">
        <plugin name="codilar_currency_format_remove_symbol_space"
                type="Codilar\CurrencyFormat\Plugin\RemoveSymbolSpace"/>
    </type>
    <!-- Price pattern used by JavaScript (price boxes, mini cart, checkout) -->
    <type name="Magento\Framework\Locale\Format">
        <plugin name="codilar_currency_format_remove_symbol_space"
                type="Codilar\CurrencyFormat\Plugin\RemoveSymbolSpace"/>
    </type>
</config>
