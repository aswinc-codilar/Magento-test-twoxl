# Magento 2 project (Composer install) - keep the repo to source code + config.
# Everything ignored here is downloaded by `composer install` or regenerated by Magento.

# ------------------------------------------------------------------
# Secrets / environment specific (never commit)
# ------------------------------------------------------------------
/app/etc/env.php
/auth.json
/.env
/.user.ini.local

# ------------------------------------------------------------------
# Composer dependencies (restore with `composer install`)
# ------------------------------------------------------------------
/vendor/

# Magento core folders copied into the project by the magento/magento2-base package.
# composer.json has "magento-force": "override", so `composer install` always restores (and overwrites) them.
/bin/
/dev/
/lib/
/phpserver/
/setup/

# ------------------------------------------------------------------
# Generated code, caches, logs, sessions (rebuilt by Magento)
# Keep the .htaccess files: they block web access to these folders.
# ------------------------------------------------------------------
/generated/*
!/generated/.htaccess

/var/*
!/var/.htaccess

# ------------------------------------------------------------------
# Deployed static files (rebuilt by setup:static-content:deploy / on demand in developer mode)
# ------------------------------------------------------------------
/pub/static/*
!/pub/static/.htaccess

# ------------------------------------------------------------------
# Media: uploaded/resized catalog images, imports, sitemaps (stored per environment, not in git)
# ------------------------------------------------------------------
/pub/media/*
!/pub/media/.htaccess

# Error page reports created at runtime
/pub/errors/local.xml

# ------------------------------------------------------------------
# Front-end tooling
# ------------------------------------------------------------------
node_modules/
/package.json
/package-lock.json
/Gruntfile.js
/grunt-config.json
/dev/tools/grunt/configs/local-themes.js

# ------------------------------------------------------------------
# PHP tooling caches
# ------------------------------------------------------------------
/.php-cs-fixer.cache
/.php_cs.cache
/.phpunit.result.cache
/dev/tests/*/tmp/

# ------------------------------------------------------------------
# IDE / editor / OS files
# ------------------------------------------------------------------
/.idea/
/.vscode/
/.claude/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ------------------------------------------------------------------
# Database dumps and archives
# ------------------------------------------------------------------
*.sql
*.sql.gz
*.tar.gz
*.zip
